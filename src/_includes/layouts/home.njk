---
layout: layouts/base.njk
templateClass: tmpl-home
---

<div class="wrapper home">
  <div class="content">
    {{ content | safe }}

    <div class="divider"></div>

    <section id="notes">
      <div class="section-label">// notes</div>
      <ul class="notes-list">
        {%- for post in collections.posts | reverse -%}
          <li>
            <span class="date">{{ post.data.page.date | htmlDateString }}</span>
            <a href='{{ post.url }}'>{{ post.data.title }}</a>
          </li>
        {%- endfor -%}
      </ul>
      <div class="view-all"><a href="/notes">view all →</a></div>
    </section>

    <section class="things-section">
      <div class="section-label">// things</div>
      <div class="things-list">
        {%- for post in collections.things | reverse -%}
          {%- if loop.index <= 10 -%}
          <div class="thing-item">
            <a href="{{ post.data.link }}" class="thing-link">
              <span>{{ post.data.title }}</span>
              <span class="thing-desc">{{ post.data.description }}</span>
              <span class="arrow">{% if post.data.link and ('http' in post.data.link) %}↗{% else %}→{% endif %}</span>
            </a>
          </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="view-all"><a href="/things">view all →</a></div>
    </section>

  </div>
</div>
