<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/public/favicon.svg" type="image/svg+xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0B5192"
    <meta name="description" content="Marcsist" />
    <link rel="stylesheet" type="text/css" href="/public/style.css" />
    {% seo "" %}
    <!-- Global site tag (gtag.js) - Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-LLJT1DPC30"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-LLJT1DPC30');
    </script>
  <!-- Vercel - Speed Insights -->
    <script>
  window.si = window.si || function () { (window.siq = window.siq || []).push(arguments); };
</script>
<script defer src="/_vercel/speed-insights/script.js"></script>
  </head>
  <header>
    <div class="site-id"><span class="slash">/</span><a href="/">marcsist</a></div>
    <nav>
      {% set navPages = collections.all | eleventyNavigation %}
      <ul>
      {%- for entry in navPages %}
        <li{% if entry.url == page.url %} class="my-active-class"{% endif %}>
          <a href="{{ entry.url | url }}">{{ entry.title | lower }}</a>
        </li>
      {%- endfor %}
      </ul>
    </nav>
</header>
  <body>
  <main>

    {{ content | safe }}

  </main>

    {% include 'layouts/blocks/footer.njk' %}
    <script src="/public/theme-switcher.js"></script>
    <script>
      document.querySelectorAll('.things-list .thing-link').forEach(function(link) {
        var desc = link.querySelector('.thing-desc');
        if (!desc) return;
        link.addEventListener('mouseenter', function() {
          var overflow = desc.scrollWidth - desc.offsetWidth;
          if (overflow > 0) {
            desc.style.setProperty('--marquee-offset', '-' + overflow + 'px');
            desc.style.setProperty('--marquee-duration', Math.max(2.5, overflow / 25) + 's');
            desc.classList.add('is-overflowing');
          }
        });
        link.addEventListener('mouseleave', function() {
          desc.classList.remove('is-overflowing');
        });
      });
    </script>
    <script>
      window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
    </script>
    <script defer src="/_vercel/insights/script.js"></script>
  </body>
</html>
