</header>
  <body>
  <main>

    {{ content | safe }}

  </main>

    {% include 'layouts/blocks/footer.njk' %}
    <script src="/public/theme-switcher.js"></script>
    <script>
      document.querySelectorAll('.things-list .thing-link').forEach(function(link) {
        var desc = link.querySelector('.thing-desc');
        if (!desc) return;
        link.addEventListener('mouseenter', function() {
          var overflow = desc.scrollWidth - desc.offsetWidth;
          if (overflow > 0) {
            desc.style.setProperty('--marquee-offset', '-' + overflow + 'px');
            desc.style.setProperty('--marquee-duration', Math.max(2.5, overflow / 25) + 's');
            desc.classList.add('is-overflowing');
          }
        });
        link.addEventListener('mouseleave', function() {
          desc.classList.remove('is-overflowing');
        });
      });
    </script>
    <script>
      (function() {
        var lb = document.createElement('div');
        lb.id = 'lightbox';
        lb.setAttribute('aria-modal', 'true');
        lb.setAttribute('role', 'dialog');
        var img = document.createElement('img');
        img.id = 'lightbox-img';
        img.alt = '';
        var btn = document.createElement('button');
        btn.id = 'lightbox-close';
        btn.textContent = 'esc';
        lb.appendChild(img);
        lb.appendChild(btn);
        document.body.appendChild(lb);

        var imgs = [];
        var current = 0;

        function open(index) {
          current = (index + imgs.length) % imgs.length;
          img.src = imgs[current].src;
          lb.classList.add('is-open');
          document.body.style.overflow = 'hidden';
        }

        function close() {
          lb.classList.remove('is-open');
          document.body.style.overflow = '';
        }

        imgs = Array.from(document.querySelectorAll('img:not(#lightbox-img)'));

        imgs.forEach(function(el, i) {
          el.addEventListener('click', function() { open(i); });
        });

        lb.addEventListener('click', function(e) {
          if (e.target !== img) close();
        });

        btn.addEventListener('click', close);

        document.addEventListener('keydown', function(e) {
          if (!lb.classList.contains('is-open')) return;
          if (e.key === 'Escape') close();
          if (e.key === 'ArrowRight') open(current + 1);
          if (e.key === 'ArrowLeft') open(current - 1);
        });
      })();
    </script>
    <script>
      window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
    </script>
    <script defer src="/_vercel/insights/script.js"></script>
  </body>
</html>
